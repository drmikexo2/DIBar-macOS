/// Copy this file to Secrets.swift (same directory) and fill in your own
/// keys. Secrets.swift is gitignored so credentials never land in the repo.
/// Get Last.fm API credentials at last.fm/api/account/create. With empty
/// values the app builds and runs fine; the Last.fm row in Settings shows
/// "Requires an API key" and scrobbling stays off.
enum Secrets {
    static let lastFMAPIKey = ""
    static let lastFMSharedSecret = ""
}
